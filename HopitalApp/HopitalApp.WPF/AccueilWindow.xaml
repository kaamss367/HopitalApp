<Window x:Class="HopitalApp.WPF.AccueilWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Accueil" Height="400" Width="600">

    <Grid Margin="20">
        <StackPanel>

            <TextBlock Text="Espace Accueil"
                       FontSize="26"
                       FontWeight="Bold"
                       Margin="0,0,0,20"/>

            <TextBlock Text="Vous pouvez gérer les patients et les rendez-vous."
                       FontSize="16"
                       Margin="0,0,0,20"/>

            <WrapPanel>
                <Button Content="Patients"
                        Width="150"
                        Height="45"
                        Margin="5"
                        Click="BtnPatients_Click"/>

                <Button Content="Rendez-vous"
                        Width="150"
                        Height="45"
                        Margin="5"
                        Click="BtnRendezVous_Click"/>
            </WrapPanel>

        </StackPanel>
    </Grid>
</Window>