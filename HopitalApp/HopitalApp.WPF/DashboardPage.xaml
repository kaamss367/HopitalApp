<UserControl x:Class="HopitalApp.WPF.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource PageBg}">

    <UserControl.Resources>
        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background"      Value="White"/>
            <Setter Property="BorderBrush"     Value="#F8C8D8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="12"/>
            <Setter Property="Padding"         Value="28,22"/>
            <Setter Property="Margin"          Value="0,0,20,20"/>
            <Setter Property="Width"           Value="170"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Color="#F8BBD9" Opacity="0.4"/>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,32,36,32">

            <TextBlock Text="Tableau de bord" FontSize="26" FontWeight="Bold"
                       Foreground="{StaticResource TitleBrush}" Margin="0,0,0,6"/>
            <TextBlock Text="Vue d'ensemble de l'activité" FontSize="13"
                       Foreground="#B06080" Margin="0,0,0,28"/>

            <WrapPanel>
                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="👤" FontSize="28" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="txtNbPatients" Text="—" FontSize="32"
                                   FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Patients" FontSize="13" Foreground="#880E4F"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="🩺" FontSize="28" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="txtNbMedecins" Text="—" FontSize="32"
                                   FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Médecins" FontSize="13" Foreground="#880E4F"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="🏷" FontSize="28" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="txtNbSpecialites" Text="—" FontSize="32"
                                   FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Spécialités" FontSize="13" Foreground="#880E4F"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="📅" FontSize="28" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="txtNbRendezVous" Text="—" FontSize="32"
                                   FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Rendez-vous" FontSize="13" Foreground="#880E4F"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </WrapPanel>

        </StackPanel>
    </ScrollViewer>

</UserControl>
