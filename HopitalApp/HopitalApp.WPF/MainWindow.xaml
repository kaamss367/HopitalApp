<Window x:Class="HopitalApp.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Connexion — Hôpital" Height="480" Width="420"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#FFF5F8">

    <Grid>
        <!-- Bandeau haut rose -->
        <Rectangle VerticalAlignment="Top" Height="120" Fill="#C2185B"/>

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="300">

            <!-- Logo texte centré dans le bandeau -->
            <TextBlock Text="🏥 Hôpital" FontSize="30" FontWeight="Bold"
                       Foreground="White" HorizontalAlignment="Center"
                       Margin="0,0,0,60"/>

            <!-- Carte blanche -->
            <Border Background="White" CornerRadius="10" Padding="28,24"
                    BorderBrush="#F8C8D8" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2"
                                      Color="#F8BBD9" Opacity="0.5"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Connexion" FontSize="20" FontWeight="Bold"
                               Foreground="#880E4F" Margin="0,0,0,20"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="Identifiant" Foreground="#880E4F" FontSize="12"
                               Margin="0,0,0,4"/>
                    <TextBox x:Name="txtLogin" Margin="0,0,0,14"/>

                    <TextBlock Text="Mot de passe" Foreground="#880E4F" FontSize="12"
                               Margin="0,0,0,4"/>
                    <PasswordBox x:Name="txtPassword" Margin="0,0,0,22"/>

                    <Button Content="Se connecter" Height="40" FontSize="14"
                            Click="BtnConnexion_Click"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </Grid>
</Window>
