<Window x:Class="HopitalApp.WPF.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Administration" Height="450" Width="700">

    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Tableau de bord administrateur"
                       FontSize="26"
                       FontWeight="Bold"
                       Margin="0,0,0,20"/>

            <WrapPanel Margin="0,0,0,20">
                <Button Content="Patients" Width="130" Height="40" Margin="5" Click="BtnPatients_Click"/>
                <Button Content="Médecins" Width="130" Height="40" Margin="5" Click="BtnMedecins_Click"/>
                <Button Content="Spécialités" Width="130" Height="40" Margin="5" Click="BtnSpecialites_Click"/>
                <Button Content="Rendez-vous" Width="130" Height="40" Margin="5" Click="BtnRendezVous_Click"/>
            </WrapPanel>

            <TextBlock Text="Bienvenue dans l'espace administrateur."
                       FontSize="16"/>
        </StackPanel>
    </Grid>
</Window>