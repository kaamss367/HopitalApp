<Window x:Class="HopitalApp.WPF.RendezVousWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestion des rendez-vous" Height="600" Width="1000">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Barre de filtres -->
        <WrapPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Médecin" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <ComboBox x:Name="cbFiltreMedecin" Width="140" Margin="0,0,15,0"
                      DisplayMemberPath="NomComplet" SelectedValuePath="Id"/>

            <TextBlock Text="Patient" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <ComboBox x:Name="cbFiltrePatient" Width="140" Margin="0,0,15,0"
                      DisplayMemberPath="NomComplet" SelectedValuePath="Id"/>

            <TextBlock Text="Du" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <DatePicker x:Name="dpFiltreDebut" Width="120" Margin="0,0,10,0"/>
            <TextBlock Text="Au" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <DatePicker x:Name="dpFiltreFin" Width="120" Margin="0,0,15,0"/>

            <CheckBox x:Name="chkHistorique" Content="Historique (passés)"
                      VerticalAlignment="Center" Margin="0,0,15,0"/>

            <Button Content="Filtrer"      Width="80" Margin="0,0,5,0" Click="BtnFiltrer_Click"/>
            <Button Content="Réinitialiser" Width="100"               Click="BtnReset_Click"/>
        </WrapPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Liste (double-clic = détail) -->
            <DataGrid x:Name="dgRendezVous" Grid.Column="0"
                      AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                      SelectionChanged="dgRendezVous_SelectionChanged"
                      MouseDoubleClick="dgRendezVous_MouseDoubleClick"
                      Margin="0,0,10,0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Patient" Binding="{Binding Patient.NomComplet}" Width="*"/>
                    <DataGridTextColumn Header="Médecin" Binding="{Binding Medecin.NomComplet}" Width="*"/>
                    <DataGridTextColumn Header="Début"
                        Binding="{Binding DateDebut, StringFormat='dd/MM/yyyy HH:mm'}" Width="*"/>
                    <DataGridTextColumn Header="Fin"
                        Binding="{Binding DateFin, StringFormat='dd/MM/yyyy HH:mm'}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Formulaire -->
            <StackPanel Grid.Column="1">
                <TextBlock Text="Rendez-vous" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>

                <TextBlock Text="Patient"/>
                <ComboBox x:Name="cbPatient" DisplayMemberPath="NomComplet"
                          SelectedValuePath="Id" Margin="0,2,0,8"/>

                <TextBlock Text="Médecin"/>
                <ComboBox x:Name="cbMedecin" DisplayMemberPath="NomComplet"
                          SelectedValuePath="Id" Margin="0,2,0,8"/>

                <TextBlock Text="Date début / heure (HH:mm)"/>
                <StackPanel Orientation="Horizontal" Margin="0,2,0,8">
                    <DatePicker x:Name="dpDebut" Width="120"/>
                    <TextBox x:Name="txtHeureDebut" Width="60" Margin="6,0,0,0" Text="09:00"/>
                </StackPanel>

                <TextBlock Text="Date fin / heure (HH:mm)"/>
                <StackPanel Orientation="Horizontal" Margin="0,2,0,8">
                    <DatePicker x:Name="dpFin" Width="120"/>
                    <TextBox x:Name="txtHeureFin" Width="60" Margin="6,0,0,0" Text="09:30"/>
                </StackPanel>

                <TextBlock Text="Informations complémentaires"/>
                <TextBox x:Name="txtInfos" Height="60" TextWrapping="Wrap"
                         AcceptsReturn="True" Margin="0,2,0,15"/>

                <Button Content="Ajouter"         Height="35" Margin="0,0,0,5" Click="BtnAjouter_Click"/>
                <Button Content="Modifier"        Height="35" Margin="0,0,0,5" Click="BtnModifier_Click"/>
                <Button Content="Supprimer"       Height="35" Margin="0,0,0,5" Click="BtnSupprimer_Click"/>
                <Button Content="Nouveau / Vider" Height="35"                  Click="BtnVider_Click"/>

                <!-- ✅ NOUVEAU BOUTON PDF -->
                <Button Content="Générer fiche PDF"
        Height="35"
        Margin="0,5,0,0"
        Click="BtnGenererPdf_Click"/>


            </StackPanel>
        </Grid>
    </Grid>
</Window>