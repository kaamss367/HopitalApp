<Window x:Class="HopitalApp.WPF.MedecinWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestion des médecins" Height="500" Width="850">
    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <DataGrid x:Name="dgMedecins" Grid.Column="0"
                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                  SelectionChanged="dgMedecins_SelectionChanged" Margin="0,0,10,0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Id"         Binding="{Binding Id}"            Width="40"/>
                <DataGridTextColumn Header="Nom"        Binding="{Binding Nom}"           Width="*"/>
                <DataGridTextColumn Header="Prénom"     Binding="{Binding Prenom}"        Width="*"/>
                <DataGridTextColumn Header="Spécialité" Binding="{Binding Specialite.Nom}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Column="1">
            <TextBlock Text="Fiche médecin" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
            <TextBlock Text="Nom"/>
            <TextBox x:Name="txtNom"    Margin="0,2,0,8"/>
            <TextBlock Text="Prénom"/>
            <TextBox x:Name="txtPrenom" Margin="0,2,0,8"/>

            <TextBlock Text="Spécialité"/>
            <ComboBox x:Name="cbSpecialite"
                      DisplayMemberPath="Nom"
                      SelectedValuePath="Id"
                      Margin="0,2,0,15"/>

            <Button Content="Ajouter"         Height="35" Margin="0,0,0,5" Click="BtnAjouter_Click"/>
            <Button Content="Modifier"        Height="35" Margin="0,0,0,5" Click="BtnModifier_Click"/>
            <Button Content="Supprimer"       Height="35" Margin="0,0,0,5" Click="BtnSupprimer_Click"/>
            <Button Content="Nouveau / Vider" Height="35"                  Click="BtnVider_Click"/>
        </StackPanel>
    </Grid>
</Window>