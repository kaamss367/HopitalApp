<Window x:Class="HopitalApp.WPF.PatientWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestion des patients" Height="500" Width="850">
    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <DataGrid x:Name="dgPatients" Grid.Column="0"
                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                  SelectionChanged="dgPatients_SelectionChanged" Margin="0,0,10,0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Id"        Binding="{Binding Id}"        Width="40"/>
                <DataGridTextColumn Header="Nom"       Binding="{Binding Nom}"       Width="*"/>
                <DataGridTextColumn Header="Prénom"    Binding="{Binding Prenom}"    Width="*"/>
                <DataGridTextColumn Header="Téléphone" Binding="{Binding Telephone}" Width="*"/>
                <DataGridTextColumn Header="Email"     Binding="{Binding Email}"     Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Column="1">
            <TextBlock Text="Fiche patient" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
            <TextBlock Text="Nom"/>
            <TextBox x:Name="txtNom"       Margin="0,2,0,8"/>
            <TextBlock Text="Prénom"/>
            <TextBox x:Name="txtPrenom"    Margin="0,2,0,8"/>
            <TextBlock Text="Téléphone"/>
            <TextBox x:Name="txtTelephone" Margin="0,2,0,8"/>
            <TextBlock Text="Email"/>
            <TextBox x:Name="txtEmail"     Margin="0,2,0,15"/>

            <Button Content="Ajouter"        Height="35" Margin="0,0,0,5" Click="BtnAjouter_Click"/>
            <Button Content="Modifier"       Height="35" Margin="0,0,0,5" Click="BtnModifier_Click"/>
            <Button Content="Supprimer"      Height="35" Margin="0,0,0,5" Click="BtnSupprimer_Click"/>
            <Button Content="Nouveau / Vider" Height="35"                 Click="BtnVider_Click"/>
        </StackPanel>
    </Grid>
</Window>