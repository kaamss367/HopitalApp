<Window x:Class="HopitalApp.WPF.RendezVousDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Détail du rendez-vous" Height="400" Width="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Titre -->
        <TextBlock Grid.Row="0" Text="Détail du rendez-vous"
                   FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

        <!-- Infos -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Patient :" FontWeight="Bold" Margin="0,0,12,10"/>
            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="lblPatient" TextWrapping="Wrap"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Médecin :" FontWeight="Bold" Margin="0,0,12,10"/>
            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="lblMedecin" TextWrapping="Wrap"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Début :" FontWeight="Bold" Margin="0,0,12,10"/>
            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="lblDebut"/>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Fin :" FontWeight="Bold" Margin="0,0,12,10"/>
            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="lblFin"/>

            <TextBlock Grid.Row="4" Grid.Column="0" Text="Infos :" FontWeight="Bold"
                       Margin="0,10,12,0" VerticalAlignment="Top"/>
            <TextBox Grid.Row="4" Grid.Column="1" x:Name="txtInfos"
                     IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                     Background="Transparent" BorderThickness="0"
                     Margin="0,10,0,0" VerticalScrollBarVisibility="Auto"/>
        </Grid>

        <!-- Fermer -->
        <Button Grid.Row="2" Content="Fermer" Width="100" HorizontalAlignment="Right"
                Margin="0,15,0,0" Height="32" Click="BtnFermer_Click"/>
    </Grid>
</Window>
