<UserControl x:Class="HopitalApp.WPF.SpecialitePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource PageBg}">
    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="🏷️  Spécialités" FontSize="22" FontWeight="Bold"
                       Foreground="{StaticResource TitleBrush}"/>
            <TextBlock Text="Gestion des spécialités médicales" FontSize="12"
                       Foreground="#B06080" Margin="0,2,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="260"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" CornerRadius="10"
                    BorderBrush="#F8C8D8" BorderThickness="1" Margin="0,0,16,0">
                <DataGrid x:Name="dgSpecialites" AutoGenerateColumns="False" IsReadOnly="True"
                          SelectionMode="Single" SelectionChanged="dgSpecialites_SelectionChanged"
                          BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Id"  Binding="{Binding Id}"  Width="60"/>
                        <DataGridTextColumn Header="Nom" Binding="{Binding Nom}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border Grid.Column="1" Background="White" CornerRadius="10"
                    BorderBrush="#F8C8D8" BorderThickness="1" Padding="18,16">
                <StackPanel>
                    <TextBlock Text="Fiche spécialité" FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource TitleBrush}" Margin="0,0,0,14"/>

                    <TextBlock Text="Nom" Foreground="#880E4F" FontSize="12" Margin="0,0,0,3"/>
                    <TextBox x:Name="txtNom" Margin="0,0,0,18"/>

                    <Button Content="Ajouter"         Height="34" Margin="0,0,0,6" Click="BtnAjouter_Click"/>
                    <Button Content="Modifier"        Height="34" Margin="0,0,0,6" Click="BtnModifier_Click"/>
                    <Button Content="Supprimer"       Height="34" Margin="0,0,0,6" Click="BtnSupprimer_Click"/>
                    <Button Content="Nouveau / Vider" Height="34"                  Click="BtnVider_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
